{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".nuxt/**", "!.nuxt/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:prepare": {
      "cache": false
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false
    },
    "prepack": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
